{
  "name": "quillbill",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:ssr && node scripts/prerender.mjs && node scripts/gen-downloads.mjs dist",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr-build --logLevel warn",
    "build:client": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "audit:seo": "node scripts/seo-audit.mjs dist",
    "audit:qa": "node scripts/qa-audit.mjs",
    "audit": "npm run audit:qa && npm run audit:seo",
    "gen:guides": "node scripts/gen-guide-index.mjs",
    "gen:downloads": "node scripts/gen-downloads.mjs dist"
  },
  "dependencies": {
    "lucide-react": "^0.570.0",
    "lz-string": "^1.5.0",
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
